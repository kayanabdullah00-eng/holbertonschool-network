#!/usr/bin/env bash
# Configures localhost to 127.0.0.2 and facebook.com to 8.8.8.8

cp /etc/hosts /tmp/hosts

sed 's/127\.0\.0\.1[[:space:]]*localhost/127.0.0.2 localhost/' /tmp/hosts |
    grep -v 'facebook\.com' > /tmp/hosts_new

echo '8.8.8.8 facebook.com' >> /tmp/hosts_new

cat /tmp/hosts_new > /etc/hosts

rm -f /tmp/hosts /tmp/hosts_new
